<?xml version= "1.0" encoding = "utf-8" ?>
<ru.playsoftware.j2meloader.applist.AppItemLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?android:selectableItemBackground"
    android:padding="12dp"
    android:focusable="true"
    tools:showIn="@layout/fragment_apps_list">

    <ImageView
        android:id="@+id/list_image"
        android:background="@drawable/bg_app_icon"
        android:clipToOutline="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="14dp"
        android:layout_marginRight="14dp"
        android:scaleType="centerCrop"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/list_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?android:textAppearance"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Example MIDlet Name" />

        <!-- Author and version app -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/list_author"
                style="@style/TextViewVendor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?android:textAppearance"
                android:textColor="?textColorSecondary"
                android:textSize="12sp"
                tools:text="Example MIDlet Vendor Ltd." />

            <TextView
                android:id="@+id/list_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:textAppearance"
                android:textColor="?textColorSecondary"
                android:textSize="12sp"
                tools:text="1.0.254" />
        </LinearLayout>
    </LinearLayout>

</ru.playsoftware.j2meloader.applist.AppItemLayout>
